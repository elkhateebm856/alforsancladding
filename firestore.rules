rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'KS2tzaUCrachoXvCoJUeDRYrQt32'
        && request.auth.token.email == 'alforsancladding@gmail.com'
    }

    match /articles/{slug} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /pages/{slug} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{id} {
      allow read: if isAdmin() || resource.data.status == 'approved';
      allow create: if isAdmin() || (request.resource.data.keys().hasAll([
          'name', 'rating', 'text', 'sourcePath', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'rating', 'text', 'sourcePath', 'status', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 10
        && request.resource.data.text.size() <= 1200
        && request.resource.data.sourcePath is string
        && request.resource.data.sourcePath.size() <= 256
        && (request.resource.data.sourcePath == '/'
          || request.resource.data.sourcePath.matches('^/[^/].*$'))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time);
      allow update, delete: if isAdmin();
    }

    match /contentVisibility/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mediaAssets/{mediaId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll([
          'bytes', 'contentType', 'createdAt', 'height', 'originalName', 'ownerUid', 'width'
        ])
        && request.resource.data.keys().hasOnly([
          'bytes', 'contentType', 'createdAt', 'height', 'originalName', 'ownerUid', 'width'
        ])
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 700000
        && request.resource.data.contentType == 'image/webp'
        && request.resource.data.originalName is string
        && request.resource.data.originalName.size() <= 180
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.width is int
        && request.resource.data.width > 0
        && request.resource.data.width <= 4096
        && request.resource.data.height is int
        && request.resource.data.height > 0
        && request.resource.data.height <= 4096
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
