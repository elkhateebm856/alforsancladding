# Firebase client configuration (Firebase Console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=alforsancladding.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=alforsancladding
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Keep false until the project owner approves Storage billing and configures the bucket.
NEXT_PUBLIC_ADMIN_IMAGE_UPLOADS_ENABLED=false

# Optional server-only Firebase Admin credentials for protected legacy APIs and migration tooling.
# The browser admin dashboard uses Firebase Auth + Firestore rules and does not need these.
FIREBASE_PROJECT_ID=alforsancladding
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Instead of the two variables above, a single service-account JSON value may be used:
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# Comma-separated allowlist for server-side Admin SDK routes.
ADMIN_EMAILS=alforsancladding@gmail.com
